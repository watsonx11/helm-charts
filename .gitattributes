* text=auto eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.toml text eol=lf
*.tpl text eol=lf
*.gotmpl text eol=lf
*.txt text eol=lf

# Packaged charts and provenance files are binary artifacts.
*.tgz binary
*.prov binary

# Chart templates are Go templates, not YAML. Telling GitHub so keeps the
# language statistics and syntax highlighting honest.
charts/*/templates/* linguist-language=Go

# charts/*/README.md is generated by helm-docs; collapse it in PR diffs.
charts/*/README.md linguist-generated=true
